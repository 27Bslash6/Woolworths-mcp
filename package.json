{
  "name": "woolworths-mcp-server",
  "version": "1.0.0",
  "description": "MCP server for Woolworths Australia with session cookie management",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "lint": "oxlint --type-aware --deny-warnings src/",
    "test": "tsc && node --test \"test/*.test.js\""
  },
  "keywords": [
    "mcp",
    "woolworths",
    "grocery",
    "shopping"
  ],
  "author": "",
  "license": "GPL-3.0-only",
  "dependencies": {
    "@cachekit-io/cachekit": "0.2.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "puppeteer": "25.12.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2004",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@11.9.0"
}
